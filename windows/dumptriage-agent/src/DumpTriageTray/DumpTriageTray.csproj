    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DumpTriage.Common\DumpTriage.Common.csproj" />
  </ItemGroup>

</Project>
