{
  "schemaVersion": 1,
  "semantics": [
    "Samples are [tSec, value] in ascending tSec; history[].atSec are earlier capture times on the same clock (negative = before the series).",
    "A run starts at the first sample with value >= threshold and ends at any sample below it.",
    "The trigger is met at the first sample of a run whose tSec - runStartTSec >= sustainSec. Only that first met moment is decided.",
    "At that moment: if a capture exists with atSec > metTSec - cooldownMin*60 the outcome is cooldown;",
    "otherwise if the count of captures with atSec > metTSec - 86400 is >= dailyCap the outcome is capped; otherwise fire.",
    "If the trigger is never met the outcome is no_fire. atSec is the met moment and is absent for no_fire."
  ],
  "cases": [
    {
      "name": "sustained_at_threshold_fires",
      "why": "A run at or above the threshold of exactly sustainSec fires at its last sample.",
      "trigger": {
        "name": "cpu-high",
        "type": "cpuPercent",
        "threshold": 90,
        "sustainSec": 30
      },
      "limits": {
        "cooldownMin": 60,
        "dailyCap": 4
      },
      "history": [],
      "series": [
        {
          "tSec": 0,
          "value": 90
        },
        {
          "tSec": 5,
          "value": 90
        },
        {
          "tSec": 10,
          "value": 90
        },
        {
          "tSec": 15,
          "value": 90
        },
        {
          "tSec": 20,
          "value": 90
        },
        {
          "tSec": 25,
          "value": 90
        },
        {
          "tSec": 30,
          "value": 90
        }
      ],
      "expect": {
        "outcome": "fire",
        "atSec": 30
      }
    },
